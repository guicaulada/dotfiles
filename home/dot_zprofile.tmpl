# Homebrew paths without launching brew on every login shell.
{{- if eq .chezmoi.os "darwin" }}
export HOMEBREW_CELLAR="$HOMEBREW_PREFIX/Cellar"
export HOMEBREW_REPOSITORY="{{ if eq .chezmoi.arch "arm64" }}{{ index .paths.homebrew .chezmoi.arch }}{{ else }}/usr/local/Homebrew{{ end }}"
export INFOPATH="$HOMEBREW_PREFIX/share/info:${INFOPATH:-}"
{{- end }}

# XDG base directories
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# Editor
export EDITOR={{ .editor }}
export VISUAL={{ .editor }}

# Ripgrep
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

# PATH
export PATH="$HOME/.local/bin:$PATH"
export PATH="$PATH:$HOME/{{ .paths.gobin }}"
{{- if eq .chezmoi.os "darwin" }}
GCS_PATH="{{ index .paths.homebrew .chezmoi.arch }}/{{ .paths.gcloud }}"
[ -d "$GCS_PATH" ] && export PATH="$GCS_PATH:$PATH"
export PATH="$PATH:/Applications/Obsidian.app/Contents/MacOS"
{{- end }}

# macOS path_helper may reorder PATH after .zshenv; restore mise precedence.
if [[ -d "$XDG_DATA_HOME/mise/shims" ]]; then
  path=("$XDG_DATA_HOME/mise/shims" $path)
fi
